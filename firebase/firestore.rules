rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. User Resident Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // 2. Cases / Waste Reports
    match /cases/{caseId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'SUBMITTED'
        && request.resource.data.assignedOrgId == null;

      allow update: if isSignedIn();

      // Confirmations subcollection
      match /confirmations/{confirmationId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && confirmationId == 'conf_' + request.auth.uid + '_' + caseId;
        allow update, delete: if false;
      }

      // Audit Events subcollection
      match /audit_events/{eventId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // 3. Field Tasks & Operations
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();

      match /comments/{commentId} {
        allow read, create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // 4. Community Activities & Drives
    match /community_activities/{activityId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();

      match /participants/{participantId} {
        allow read, create, update, delete: if isSignedIn();
      }
    }

    // 5. Organizations
    match /organizations/{orgId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
