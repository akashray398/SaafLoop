rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. User Resident Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // 2. Cases / Waste Reports
    match /cases/{caseId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'SUBMITTED'
        && request.resource.data.assignedOrgId == null;

      allow update: if isSignedIn();

      // Confirmations subcollection - Single confirmation per resident enforcement
      match /confirmations/{confirmationId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && confirmationId == 'conf_' + request.auth.uid + '_' + caseId;
        allow update, delete: if false;
      }
    }

    // 3. Organisations
    match /organisations/{orgId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
